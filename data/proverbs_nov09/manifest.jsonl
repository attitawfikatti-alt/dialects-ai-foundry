{"id": "nov09_0001", "audio_file": "wavs/chunk_0000.wav", "transcript": "الضحك يفك الشدايد والهم ما يبني حيط", "region": "proverbs_nov09"}
{"id": "nov09_0002", "audio_file": "wavs/chunk_0001.wav", "transcript": "طول الخط ما يدير كبة وطول الحديث ما يدير هبة", "region": "proverbs_nov09"}
{"id": "nov09_0003", "audio_file": "wavs/chunk_0002.wav", "transcript": "كي طارت الطيور جات الهامة دور", "region": "proverbs_nov09"}
{"id": "nov09_0004", "audio_file": "wavs/chunk_0003.wav", "transcript": "يحرث علي ضحا غير ثور لعشاوي", "region": "proverbs_nov09"}
{"id": "nov09_0005", "audio_file": "wavs/chunk_0004.wav", "transcript": "لي حشم وجهه ضره", "region": "proverbs_nov09"}
{"id": "nov09_0006", "audio_file": "wavs/chunk_0005.wav", "transcript": "يحس بالجمرة غيلي كواته", "region": "proverbs_nov09"}
{"id": "nov09_0007", "audio_file": "wavs/chunk_0006.wav", "transcript": "لدارها بيديه يفكها بسنيه", "region": "proverbs_nov09"}
{"id": "nov09_0008", "audio_file": "wavs/chunk_0007.wav", "transcript": "الجمل ما يشوف حدبته يشوف حدبت خوه", "region": "proverbs_nov09"}
{"id": "nov09_0009", "audio_file": "wavs/chunk_0008.wav", "transcript": "قل و دايم خير من قليل و مقطوع", "region": "proverbs_nov09"}
{"id": "nov09_0010", "audio_file": "wavs/chunk_0009.wav", "transcript": "ش راك متفكرنا ولا قطعت رجا", "region": "proverbs_nov09"}
{"id": "nov09_0011", "audio_file": "wavs/chunk_0010.wav", "transcript": "ال يعطيك الصحة والعافية", "region": "proverbs_nov09"}
{"id": "nov09_0012", "audio_file": "wavs/chunk_0011.wav", "transcript": "واش خبارك وكيفاش صبحتو اليوم", "region": "proverbs_nov09"}
{"id": "nov09_0013", "audio_file": "wavs/chunk_0012.wav", "transcript": "رحمك ويرحم والديك", "region": "proverbs_nov09"}
{"id": "nov09_0014", "audio_file": "wavs/chunk_0013.wav", "transcript": "الد لله راضيين بواش عطا ربي", "region": "proverbs_nov09"}
{"id": "nov09_0015", "audio_file": "wavs/chunk_0014.wav", "transcript": "اللسان يبني ديار و يهدم ديار", "region": "proverbs_nov09"}
{"id": "nov09_0016", "audio_file": "wavs/chunk_0015.wav", "transcript": "س القايلة ولا ظل شجرتكم", "region": "proverbs_nov09"}
{"id": "nov09_0017", "audio_file": "wavs/chunk_0016.wav", "transcript": "الد بالوجوه و آخرة بالفعايل", "region": "proverbs_nov09"}
{"id": "nov09_0018", "audio_file": "wavs/chunk_0017.wav", "transcript": "ال المزموم ما تدخلو ذبانة", "region": "proverbs_nov09"}
{"id": "nov09_0019", "audio_file": "wavs/chunk_0018.wav", "transcript": "كي ن حي مشتاقي تمرة و كي مات علقوله عرجون", "region": "proverbs_nov09"}
{"id": "nov09_0020", "audio_file": "wavs/chunk_0019.wav", "transcript": "ما داتوش العمشة تديه مو شعور", "region": "proverbs_nov09"}
{"id": "nov09_0021", "audio_file": "wavs/chunk_0020.wav", "transcript": "جاك الضيم ارجع لصاحبك لقديم", "region": "proverbs_nov09"}
{"id": "nov09_0022", "audio_file": "wavs/chunk_0021.wav", "transcript": "قراه الذيب حافظه سلوقي", "region": "proverbs_nov09"}
{"id": "nov09_0023", "audio_file": "wavs/chunk_0022.wav", "transcript": "عدو ما يولي حبيب و نخلة ما تولي سميد", "region": "proverbs_nov09"}
{"id": "nov09_0024", "audio_file": "wavs/chunk_0023.wav", "transcript": "لحمار حماري ونركب من لور", "region": "proverbs_nov09"}
{"id": "nov09_0025", "audio_file": "wavs/chunk_0024.wav", "transcript": "خاصك غي سواك يا معوجت لحناك", "region": "proverbs_nov09"}
{"id": "nov09_0026", "audio_file": "wavs/chunk_0025.wav", "transcript": "علا قد فراشك مد رجليك", "region": "proverbs_nov09"}
{"id": "nov09_0027", "audio_file": "wavs/chunk_0026.wav", "transcript": "ح يزيد و سموه سعيد", "region": "proverbs_nov09"}
{"id": "nov09_0028", "audio_file": "wavs/chunk_0027.wav", "transcript": "ناكل الخبز البايت ولا سفنج شمايت", "region": "proverbs_nov09"}
{"id": "nov09_0029", "audio_file": "wavs/chunk_0028.wav", "transcript": "خوك خوك لا يغرك صاحبك", "region": "proverbs_nov09"}
{"id": "nov09_0030", "audio_file": "wavs/chunk_0029.wav", "transcript": "ذا تفاهمت لعزوج والكنة يدخل بليس للجنة", "region": "proverbs_nov09"}
{"id": "nov09_0031", "audio_file": "wavs/chunk_0030.wav", "transcript": "الدنيا قش في قش ولي تنفخ يتفش", "region": "proverbs_nov09"}
{"id": "nov09_0032", "audio_file": "wavs/chunk_0031.wav", "transcript": "لا تخمم لا دبر لا ترفد الهم ديما", "region": "proverbs_nov09"}
{"id": "nov09_0033", "audio_file": "wavs/chunk_0032.wav", "transcript": "سافر تعرف الناس وكبير القوم طيعه", "region": "proverbs_nov09"}
{"id": "nov09_0034", "audio_file": "wavs/chunk_0033.wav", "transcript": "كبير الكرش والراس ب نص فلس بيعه", "region": "proverbs_nov09"}
{"id": "nov09_0035", "audio_file": "wavs/chunk_0034.wav", "transcript": "نرقد علي الشوك عريان و نضحك للي جافاني", "region": "proverbs_nov09"}
{"id": "nov09_0036", "audio_file": "wavs/chunk_0035.wav", "transcript": "نصبر لتعوس ليام حتي ياتي زماني", "region": "proverbs_nov09"}
{"id": "nov09_0037", "audio_file": "wavs/chunk_0036.wav", "transcript": "اردم سرك و دكو في لرض سبعين قامة", "region": "proverbs_nov09"}
{"id": "nov09_0038", "audio_file": "wavs/chunk_0037.wav", "transcript": "وخلي لخلايق يشكو الي يوم القيامة", "region": "proverbs_nov09"}
{"id": "nov09_0039", "audio_file": "wavs/chunk_0038.wav", "transcript": "لا يغرك نوار الدفلة في الواد داير ضلايل", "region": "proverbs_nov09"}
{"id": "nov09_0040", "audio_file": "wavs/chunk_0039.wav", "transcript": "و يعجبك زين الطفلة حتي تشوف لفعايل", "region": "proverbs_nov09"}
{"id": "nov09_0041", "audio_file": "wavs/chunk_0040.wav", "transcript": "راح ذاك الزمان و ناسه و جا هاذ الزمان بفاسه", "region": "proverbs_nov09"}
{"id": "nov09_0042", "audio_file": "wavs/chunk_0041.wav", "transcript": "مثلت روحي مثل لحمام مكوي بصهد ناره", "region": "proverbs_nov09"}
{"id": "nov09_0043", "audio_file": "wavs/chunk_0042.wav", "transcript": "من فوق ما باين دخان ولتحت ما طابو حجاره", "region": "proverbs_nov09"}
{"id": "nov09_0044", "audio_file": "wavs/chunk_0043.wav", "transcript": "يا ذي زمان يا لغدار يا كاسرني من ذراعي", "region": "proverbs_nov09"}
{"id": "nov09_0045", "audio_file": "wavs/chunk_0044.wav", "transcript": "نزلت من كان سلطان وركبت من كان راعي", "region": "proverbs_nov09"}
{"id": "nov09_0046", "audio_file": "wavs/chunk_0045.wav", "transcript": "الشر ما يظلم حد غي لي جابه روحه", "region": "proverbs_nov09"}
{"id": "nov09_0047", "audio_file": "wavs/chunk_0046.wav", "transcript": "في شتا يقول البرد وفي الصيف يقول يا راسي", "region": "proverbs_nov09"}
{"id": "nov09_0048", "audio_file": "wavs/chunk_0047.wav", "transcript": "الا شفت لا تخبر واذا سولوك قول يا لالا", "region": "proverbs_nov09"}
{"id": "nov09_0049", "audio_file": "wavs/chunk_0048.wav", "transcript": "نوصيك يا واكل الراس في البير ارمي عظامه", "region": "proverbs_nov09"}
{"id": "nov09_0050", "audio_file": "wavs/chunk_0049.wav", "transcript": "اضحك والعب مع الناس وفمك متنله لجامه", "region": "proverbs_nov09"}
{"id": "nov09_0051", "audio_file": "wavs/chunk_0050.wav", "transcript": "لا تسرج حتى تلجم و عقد عقدة صحيحة", "region": "proverbs_nov09"}
{"id": "nov09_0052", "audio_file": "wavs/chunk_0051.wav", "transcript": "لا تتكلم حتى تخمم لا تعودلك فضيحة", "region": "proverbs_nov09"}
{"id": "nov09_0053", "audio_file": "wavs/chunk_0052.wav", "transcript": "الصاحب لا تلاعبه والنار لا تفوت عليها", "region": "proverbs_nov09"}
{"id": "nov09_0054", "audio_file": "wavs/chunk_0053.wav", "transcript": "لي بغاك بغيه كثر ولي باعك لا تشريه", "region": "proverbs_nov09"}
{"id": "nov09_0055", "audio_file": "wavs/chunk_0054.wav", "transcript": "يا قلبي نكويك بانار ولا شفيت نزيدك", "region": "proverbs_nov09"}
{"id": "nov09_0056", "audio_file": "wavs/chunk_0055.wav", "transcript": "يا قلبي خلفتلي العار وتريد من لا يريدك", "region": "proverbs_nov09"}
{"id": "nov09_0057", "audio_file": "wavs/chunk_0056.wav", "transcript": "يا ويح من طاح في بير وصعاب عليه طلوعه", "region": "proverbs_nov09"}
{"id": "nov09_0058", "audio_file": "wavs/chunk_0057.wav", "transcript": "رفرف ما لقا جنحين و يبكي ما سالو دموعه", "region": "proverbs_nov09"}
{"id": "nov09_0059", "audio_file": "wavs/chunk_0058.wav", "transcript": "ولد لحمار لا تربيه لوكان تدهن جلوده", "region": "proverbs_nov09"}
{"id": "nov09_0060", "audio_file": "wavs/chunk_0059.wav", "transcript": "الصك و العض فيه هاذي هي عادت جدوده", "region": "proverbs_nov09"}
{"id": "nov09_0061", "audio_file": "wavs/chunk_0060.wav", "transcript": "صعبت عليا يا مسكين وصعاب عليا حالك", "region": "proverbs_nov09"}
{"id": "nov09_0062", "audio_file": "wavs/chunk_0061.wav", "transcript": "نوصيك يا حارس الحلفة بلاك من دخانها يعميك", "region": "proverbs_nov09"}
{"id": "nov09_0063", "audio_file": "wavs/chunk_0062.wav", "transcript": "لا تتزوج غي لمرا لعفيفة تتعاون هي و زمان عليك", "region": "proverbs_nov09"}
