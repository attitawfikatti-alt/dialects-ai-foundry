#!/usr/bin/env python3
import argparse
import glob
import json
import os
import subprocess
import sys
import wave

WHISPER_BIN = "whisper.cpp/main" if os.path.exists("whisper.cpp/main") else "whisper.cpp/build/bin/whisper-cli"
MODEL_PATH = "whisper.cpp/models/ggml-base.bin"

def run_ingest(args):
    target_dir = os.path.join("data", args.region, "wavs")
    os.makedirs(target_dir, exist_ok=True)
    raw_files = glob.glob(os.path.join(args.input, "*.*"))
    print(f"[*] العثور على {len(raw_files)} ملف في {args.input}")
    
    count = 0
    for f in raw_files:
        ext = os.path.splitext(f)[1].lower()
        if ext in [".wav", ".mp3", ".m4a", ".ogg"]:
            out_file = os.path.join(target_dir, f"{os.path.splitext(os.path.basename(f))[0]}_16k.wav")
            cmd = ["ffmpeg", "-y", "-i", f, "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", out_file]
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            count += 1
    print(f"[+] تم تحويل وتصدير {count} ملف إلى {target_dir}")

def run_segment(args):
    region_dir = os.path.join("data", args.region, "wavs")
    wav_files = glob.glob(os.path.join(region_dir, "*.wav"))
    print(f"[*] معالجة المقاطع لولاية: {args.region} ({len(wav_files)} ملف)")
    # تجهيز أو فهرسة المقاطع
    manifest_p = os.path.join("data", args.region, "manifest.jsonl")
    entries = []
    for wf in sorted(wav_files):
        try:
            with wave.open(wf, 'r') as r:
                frames = r.getnframes()
                rate = r.getframerate()
                dur = round(frames / float(rate), 2)
        except Exception:
            dur = 0.0
        
        entries.append({
            "audio_file": os.path.relpath(wf, os.path.join("data", args.region)),
            "duration": dur,
            "transcript": "",
            "province": args.region,
            "region": args.region
        })
    with open(manifest_p, 'w', encoding='utf-8') as f:
        for item in entries:
            f.write(json.dumps(item, ensure_ascii=False) + "\n")
    print(f"[+] تم إنشاء/تحديث الـ Manifest في: {manifest_p}")

def run_transcribe(args):
    manifest_p = os.path.join("data", args.region, "manifest.jsonl")
    if not os.path.exists(manifest_p):
        print(f"[-] المانيفست غير موجود: {manifest_p}")
        return
    
    model = args.model if args.model else MODEL_PATH
    with open(manifest_p, 'r', encoding='utf-8') as f:
        records = [json.loads(line) for line in f if line.strip()]

    print(f"[*] بدء التفريغ الصوتي لـ {len(records)} عينة باستخدام {model}")
    for idx, item in enumerate(records):
        full_audio = os.path.join("data", args.region, item.get("audio_file", ""))
        if not item.get("transcript") and os.path.exists(full_audio):
            cmd = [WHISPER_BIN, "-m", model, "-f", full_audio, "-l", "ar", "-t", "4", "-nt"]
            try:
                res = subprocess.run(cmd, capture_output=True, text=True, check=True)
                clean_txt = " ".join(res.stdout.strip().split())
                item["transcript"] = clean_txt
                print(f"[{idx+1}/{len(records)}] {os.path.basename(full_audio)} -> {clean_txt}")
            except Exception as e:
                print(f"[-] خطأ في {full_audio}: {e}")

    with open(manifest_p, 'w', encoding='utf-8') as f:
        for item in records:
            f.write(json.dumps(item, ensure_ascii=False) + "\n")
    print("[+] اكتمل التفريغ وتحديث ملف الـ Manifest.")

def run_export(args):
    from huggingface_hub import HfApi
    api = HfApi()
    region_dir = os.path.join("data", args.region)
    print(f"[*] رفع بيانات {args.region} إلى المستودع: {args.hf_repo}")
    api.upload_folder(
        folder_path=region_dir,
        path_in_repo=f"data/{args.region}",
        repo_id=args.hf_repo,
        repo_type="dataset",
        commit_message=f"feat({args.region}): automated upload via foundry-cli"
    )
    print("[+] اكتمل الرفع بنجاح!")

def main():
    parser = argparse.ArgumentParser(description="dialects-ai-foundry CLI")
    subparsers = parser.add_subparsers(dest="command")

    p_ingest = subparsers.add_parser("ingest")
    p_ingest.add_argument("--input", required=True)
    p_ingest.add_argument("--region", required=True)

    p_segment = subparsers.add_parser("segment")
    p_segment.add_argument("--region", required=True)

    p_transcribe = subparsers.add_parser("transcribe")
    p_transcribe.add_argument("--region", required=True)
    p_transcribe.add_argument("--model", default=MODEL_PATH)

    p_export = subparsers.add_parser("export")
    p_export.add_argument("--region", required=True)
    p_export.add_argument("--hf-repo", required=True)

    args = parser.parse_args()
    if args.command == "ingest":
        run_ingest(args)
    elif args.command == "segment":
        run_segment(args)
    elif args.command == "transcribe":
        run_transcribe(args)
    elif args.command == "export":
        run_export(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
