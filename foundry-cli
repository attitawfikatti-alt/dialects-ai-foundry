#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import argparse, glob, json, os, re, subprocess, sys, wave

WHISPER_BIN = "whisper.cpp/main" if os.path.exists("whisper.cpp/main") else "whisper.cpp/build/bin/whisper-cli"
MODEL_PATH = "whisper.cpp/models/ggml-base.bin"

def normalize_darja(text: str) -> str:
    if not text: return ""
    text = re.sub(r"[ً-ٰٟـ]", "", text)
    text = re.sub(r"[إأآٱ]", "ا", text)
    text = re.sub(r"ى", "ي", text)
    text = re.sub(r"ة", "ه", text)
    text = re.sub(r"(.)\1{2,}", r"\1", text)
    text = re.sub(r"[^؀-ۿ\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()

def run_ingest(args):
    target = os.path.join("data", args.region, "wavs")
    os.makedirs(target, exist_ok=True)
    files = glob.glob(os.path.join(args.input, "*.*"))
    print(f"[*] Input files: {len(files)}")
    c = 0
    for f in files:
        if os.path.splitext(f)[1].lower() in [".wav", ".mp3", ".m4a", ".ogg"]:
            base = os.path.splitext(os.path.basename(f))[0]
            out = os.path.join(target, f"{base}_16k.wav")
            subprocess.run(["ffmpeg", "-y", "-i", f, "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            c += 1
    print(f"[+] Converted {c} files to {target}")

def run_segment(args):
    rdir = os.path.join("data", args.region, "wavs")
    wavs = sorted(glob.glob(os.path.join(rdir, "*.wav")))
    mp = os.path.join("data", args.region, "manifest.jsonl")
    items = []
    for w in wavs:
        dur = 0.0
        try:
            with wave.open(w, "r") as r:
                dur = round(r.getnframes() / float(r.getframerate()), 2)
        except Exception: pass
        items.append({
            "audio_file": os.path.relpath(w, os.path.join("data", args.region)),
            "duration": dur,
            "transcript": "",
            "province": args.region,
            "region": args.region
        })
    with open(mp, "w", encoding="utf-8") as f:
        for it in items:
            f.write(json.dumps(it, ensure_ascii=False) + chr(10))
    print(f"[+] Manifest saved: {mp} ({len(items)} items)")

def run_transcribe(args):
    mp = os.path.join("data", args.region, "manifest.jsonl")
    if not os.path.exists(mp):
        print(f"[-] Manifest not found: {mp}"); return
    model = args.model if args.model else MODEL_PATH
    with open(mp, "r", encoding="utf-8") as f:
        records = [json.loads(l) for l in f if l.strip()]
    upd = 0
    for idx, it in enumerate(records):
        audio = os.path.join("data", args.region, it.get("audio_file", ""))
        if not it.get("transcript") and os.path.exists(audio):
            cmd = [WHISPER_BIN, "-m", model, "-f", audio, "-l", "ar", "-t", "4", "-nt"]
            try:
                res = subprocess.run(cmd, capture_output=True, text=True, check=True)
                clean = normalize_darja(res.stdout.strip())
                it["transcript"] = clean
                upd += 1
                print(f"[{idx+1}/{len(records)}] {os.path.basename(audio)} -> {clean}")
            except Exception as e:
                print(f"[-] Error: {e}")
    with open(mp, "w", encoding="utf-8") as f:
        for it in records:
            f.write(json.dumps(it, ensure_ascii=False) + chr(10))
    print(f"[+] Transcribed & normalized {upd} items.")

def run_export(args):
    from huggingface_hub import HfApi
    api = HfApi()
    api.upload_folder(
        folder_path=os.path.join("data", args.region),
        path_in_repo=f"data/{args.region}",
        repo_id=args.hf_repo,
        repo_type="dataset",
        commit_message=f"feat({args.region}): auto upload with normalized darja"
    )
    print("[+] Exported successfully.")

def main():
    p = argparse.ArgumentParser(description="dialects-ai-foundry CLI")
    sub = p.add_subparsers(dest="cmd")
    p1 = sub.add_parser("ingest"); p1.add_argument("--input", required=True); p1.add_argument("--region", required=True)
    p2 = sub.add_parser("segment"); p2.add_argument("--region", required=True)
    p3 = sub.add_parser("transcribe"); p3.add_argument("--region", required=True); p3.add_argument("--model", default=MODEL_PATH)
    p4 = sub.add_parser("export"); p4.add_argument("--region", required=True); p4.add_argument("--hf-repo", required=True)
    args = p.parse_args()
    if args.cmd == "ingest": run_ingest(args)
    elif args.cmd == "segment": run_segment(args)
    elif args.cmd == "transcribe": run_transcribe(args)
    elif args.cmd == "export": run_export(args)
    else: p.print_help()

if __name__ == "__main__":
    main()
